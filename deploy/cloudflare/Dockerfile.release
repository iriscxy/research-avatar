FROM registry.cloudflare.com/b7d4d11f6a81ead606da87d4aa458ec9/research-avatar-studio-onlinestudiocontainer:worker

USER root
ARG CODEX_CLI_VERSION=0.147.0
RUN set -eux; \
    install_root=/opt/codex-cli; \
    mkdir -p "$install_root/node_modules/@openai/codex" "$install_root/node_modules/@openai/codex-linux-x64"; \
    CODEX_CLI_VERSION="$CODEX_CLI_VERSION" python3 -c 'import os, urllib.request; v=os.environ["CODEX_CLI_VERSION"]; urllib.request.urlretrieve(f"https://registry.npmjs.org/@openai/codex/-/codex-{v}.tgz", "/tmp/codex.tgz"); urllib.request.urlretrieve(f"https://registry.npmjs.org/@openai/codex/-/codex-{v}-linux-x64.tgz", "/tmp/codex-linux-x64.tgz")'; \
    tar -xzf /tmp/codex.tgz --strip-components=1 -C "$install_root/node_modules/@openai/codex"; \
    tar -xzf /tmp/codex-linux-x64.tgz --strip-components=1 -C "$install_root/node_modules/@openai/codex-linux-x64"; \
    rm -f /tmp/codex.tgz /tmp/codex-linux-x64.tgz; \
    ln -s "$install_root/node_modules/@openai/codex/bin/codex.js" /usr/local/bin/codex; \
    codex --version
COPY research_avatar/online_studio/ /opt/research-avatar/research_avatar/online_studio/
COPY research_avatar/online_studio/ /usr/local/lib/python3.12/site-packages/research_avatar/online_studio/
RUN python3 -c 'import json, pathlib; root = pathlib.Path("/opt/research-avatar/research_avatar/online_studio/demo_project"); config = json.loads((root / "paper/paper_studio.json").read_text()); missing = [value for value in config.get("paths", {}).values() if not (root / value).is_file()]; assert not missing, f"Demo paper_studio.json references files absent from the container image: {missing}"'
COPY research_avatar/paper_studio/ /opt/research-avatar/research_avatar/paper_studio/
COPY research_avatar/paper_studio/ /usr/local/lib/python3.12/site-packages/research_avatar/paper_studio/
COPY research_avatar/web/demo/ /opt/research-avatar/research_avatar/web/demo/
COPY research_avatar/web/demo/ /usr/local/lib/python3.12/site-packages/research_avatar/web/demo/
COPY research_avatar/paper_structure.py /opt/research-avatar/research_avatar/paper_structure.py
COPY research_avatar/paper_structure.py /usr/local/lib/python3.12/site-packages/research_avatar/paper_structure.py
COPY research_avatar/survey_bibliography.py /opt/research-avatar/research_avatar/survey_bibliography.py
COPY research_avatar/survey_bibliography.py /usr/local/lib/python3.12/site-packages/research_avatar/survey_bibliography.py
COPY research_avatar/tools/plan_conformance.py /opt/research-avatar/research_avatar/tools/plan_conformance.py
COPY research_avatar/tools/plan_conformance.py /usr/local/lib/python3.12/site-packages/research_avatar/tools/plan_conformance.py
COPY research_avatar/tools/validate_experiment_plan.py /opt/research-avatar/research_avatar/tools/validate_experiment_plan.py
COPY research_avatar/tools/validate_experiment_plan.py /usr/local/lib/python3.12/site-packages/research_avatar/tools/validate_experiment_plan.py
RUN chown -R studio:studio \
    /opt/research-avatar/research_avatar/online_studio \
    /opt/research-avatar/research_avatar/paper_studio \
    /opt/research-avatar/research_avatar/web/demo \
    /opt/research-avatar/research_avatar/paper_structure.py \
    /opt/research-avatar/research_avatar/survey_bibliography.py \
    /opt/research-avatar/research_avatar/tools/plan_conformance.py \
    /opt/research-avatar/research_avatar/tools/validate_experiment_plan.py \
    /usr/local/lib/python3.12/site-packages/research_avatar/online_studio \
    /usr/local/lib/python3.12/site-packages/research_avatar/paper_studio \
    /usr/local/lib/python3.12/site-packages/research_avatar/web/demo \
    /usr/local/lib/python3.12/site-packages/research_avatar/paper_structure.py \
    /usr/local/lib/python3.12/site-packages/research_avatar/survey_bibliography.py \
    /usr/local/lib/python3.12/site-packages/research_avatar/tools/plan_conformance.py \
    /usr/local/lib/python3.12/site-packages/research_avatar/tools/validate_experiment_plan.py
USER studio

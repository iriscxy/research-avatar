{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "research-avatar-studio",
  "main": "index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "containers": [
    {
      "class_name": "OnlineStudioContainerV13",
      "image": "registry.cloudflare.com/CLOUDFLARE_ACCOUNT_ID/research-avatar-studio-onlinestudiocontainer:REPLACE_WITH_IMAGE_TAG",
      "instance_type": "standard-1",
      "max_instances": 6,
      "constraints": {
        "regions": ["WNAM", "ENAM", "WEUR"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ONLINE_STUDIO",
        "class_name": "OnlineStudioContainerV13"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "research-avatar-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OnlineStudioContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OnlineStudioContainerV2"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["OnlineStudioContainerV3"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["OnlineStudioContainerV4"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["OnlineStudioContainerV5"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["OnlineStudioContainerV6"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["OnlineStudioContainerV7"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["OnlineStudioContainerV8"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["OnlineStudioContainerV9"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["OnlineStudioContainerV10"]
    },
    {
      "tag": "v11",
      "new_sqlite_classes": ["OnlineStudioContainerV11"]
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["OnlineStudioContainerV12"]
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["OnlineStudioContainerV13"]
    }
  ]
}

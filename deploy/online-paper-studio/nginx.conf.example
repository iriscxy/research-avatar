limit_req_zone $binary_remote_addr zone=online_auth:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name paper-studio.example.org;

    # Configure your certificate paths or let the platform manage TLS.
    ssl_certificate /etc/letsencrypt/live/paper-studio.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/paper-studio.example.org/privkey.pem;

    client_max_body_size 24m;

    location ~ ^/api/auth/(login|signup)$ {
        limit_req zone=online_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8876;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
    }

    location / {
        proxy_pass http://127.0.0.1:8876;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
    }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "research-avatar-studio",
  "main": "deploy/cloudflare/index.ts",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": true,
  "containers": [
    {
      "class_name": "OnlineStudioContainer",
      "image": "registry.cloudflare.com/CLOUDFLARE_ACCOUNT_ID/research-avatar-studio-onlinestudiocontainer:uploadflowv1",
      "instance_type": "basic",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ONLINE_STUDIO",
        "class_name": "OnlineStudioContainer"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "research-avatar-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "deploy/cloudflare/migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OnlineStudioContainer"]
    }
  ]
}

# The committed read-only online demo carries exactly one frozen reference
# context and its selected author-owned full text. Keep every other generated
# paper/profile file ignored unless it is already tracked.
!research_avatar/online_studio/demo_project/paper/
research_avatar/online_studio/demo_project/paper/*
!research_avatar/online_studio/demo_project/paper/reference_context.json
!research_avatar/online_studio/demo_project/paper/.outline-approved
!research_avatar/online_studio/demo_project/paper/sections/
research_avatar/online_studio/demo_project/paper/sections/*
!research_avatar/online_studio/demo_project/paper/sections/discussion.tex
!research_avatar/online_studio/demo_project/paper/sections/bibliography.tex

